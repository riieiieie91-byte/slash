local scSavedVisibility = {}

local function setSCMode(enabled)
    if enabled == scMode then
        return
    end

    if enabled then
        -- Lưu trạng thái hiển thị hiện tại trước khi vào SC.
        table.clear(scSavedVisibility)
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") then
                scSavedVisibility[child] = child.Visible
            end
        end
        scMode = true
        scPanel.Visible = true
        diveViewButton.Text = "<"

        -- Chỉ giữ lại thanh tiêu đề, nút X, nút < và bảng SC.
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") then
                child.Visible = (child == title
                    or child == closeBtn
                    or child == diveViewButton
                    or child == scPanel)
            end
        end
    else
        -- Khôi phục đúng trạng thái trước khi vào SC; không tự bật F/Save.
        scMode = false
        scPanel.Visible = false
        diveViewButton.Text = "View"

        for child, wasVisible in pairs(scSavedVisibility) do
            if child and child.Parent == frame then
                child.Visible = wasVisible
            end
        end
        table.clear(scSavedVisibility)
    end
end

attachBtn.MouseButton1Click:Connect(function()
