    showSyntaxPreview()
end)

-- Keep preview synchronized when text is changed by tabs/files/buttons while unfocused.
-- While focused, always show the original editable TextBox with no syntax colors.
textbox:GetPropertyChangedSignal("Text"):Connect(function()
    if textbox:IsFocused() then
        syntaxPreview.Visible = false
        textbox.TextTransparency = 0
    else
        syntaxLabel.Text = highlightLua(textbox.Text)
        syntaxPreview.CanvasPosition = Vector2.new(0, 0)
        textbox.TextTransparency = 1
        syntaxPreview.Visible = true
    end
end)


