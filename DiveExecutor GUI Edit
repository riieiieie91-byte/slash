local function escapeRichText(value)
    value = value:gsub("&", "&amp;")
    value = value:gsub("<", "&lt;")
    value = value:gsub(">", "&gt;")
    value = value:gsub('"', "&quot;")
    return value
end

local function highlightLua(source)
    local result = {}
    local i = 1
    local length = #source
    local keywords = {
        ["and"] = true, ["break"] = true, ["do"] = true,
        ["else"] = true, ["elseif"] = true, ["end"] = true,
        ["false"] = true, ["for"] = true, ["function"] = true,
        ["if"] = true, ["in"] = true, ["local"] = true,
        ["nil"] = true, ["not"] = true, ["or"] = true,
        ["repeat"] = true, ["return"] = true, ["then"] = true,
        ["true"] = true, ["until"] = true, ["while"] = true,
    }

    local function colorToken(token, color)
        result[#result + 1] = '<font color="' .. color .. '">' ..
            escapeRichText(token) .. '</font>'
    end

    while i <= length do
        local two = source:sub(i, i + 1)

        -- Lua comments, including long comments: --[[ ... ]]
        if two == "--" then
            local eq = source:match("^%-%-%[(=*)%[", i)
            if eq then
                local opener = "--[" .. eq .. "["
                local closer = "]" .. eq .. "]"
                local startBody = i + #opener
                local closeStart = source:find(closer, startBody, true)
                local finish = closeStart and (closeStart + #closer - 1) or length
                colorToken(source:sub(i, finish), "#7FAD78")
                i = finish + 1
            else
                local finish = source:find("\n", i, true)
                finish = finish and (finish - 1) or length
                colorToken(source:sub(i, finish), "#7FAD78")
                i = finish + 1
            end

        -- Quoted strings
        elseif source:sub(i, i) == '"' or source:sub(i, i) == "'" then
            local quote = source:sub(i, i)
            local j = i + 1
            while j <= length do
                local ch = source:sub(j, j)
                if ch == "\\" then
                    j = j + 2
                elseif ch == quote then
                    j = j + 1
                    break
                else
                    j = j + 1
                end
            end
            colorToken(source:sub(i, math.min(j - 1, length)), "#E6C07B")
            i = j

        -- Identifiers and keywords
        elseif source:sub(i, i):match("[%a_]") then
            local j = i + 1
            while j <= length and source:sub(j, j):match("[%w_]") do
                j = j + 1
            end
            local word = source:sub(i, j - 1)
            if keywords[word] then
                colorToken(word, "#C792EA")
            elseif word == "game" or word == "workspace" or word == "script" then
                colorToken(word, "#82AAFF")
            elseif word == "print" or word == "warn" or word == "require" or word == "loadstring" then
                colorToken(word, "#89DDFF")
            else
                result[#result + 1] = escapeRichText(word)
            end
            i = j

        -- Numeric literals
        elseif source:sub(i, i):match("%d") then
            local j = i + 1
            while j <= length and source:sub(j, j):match("[%w%.]") do
                j = j + 1
            end
            colorToken(source:sub(i, j - 1), "#F78C6C")
            i = j

        else
            result[#result + 1] = escapeRichText(source:sub(i, i))
            i = i + 1
        end
    end

    return table.concat(result)
end

local function showSyntaxPreview()
    syntaxLabel.Text = highlightLua(textbox.Text)
    syntaxPreview.CanvasPosition = Vector2.new(0, 0)
    textbox.TextTransparency = 1
    syntaxPreview.Visible = true
end

