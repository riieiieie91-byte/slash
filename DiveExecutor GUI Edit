--==================================================
-- ADD-ON: RUNNING LIGHT AROUND SCRIPT EDITOR ON EXECUTE
--==================================================
task.spawn(function()
    local TweenService = game:GetService("TweenService")
    local stroke = Instance.new("UIStroke")
    stroke.Name = "ExecuteRunningLightStroke"
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(65, 210, 255)
    stroke.Transparency = 1
    stroke.Parent = textbox

    local gradient = Instance.new("UIGradient")
    gradient.Name = "ExecuteRunningLightGradient"
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(75, 220, 255)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(160, 90, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(75, 220, 255))
    })
    gradient.Parent = stroke

    local running = false
    local function pulse()
        if running then return end
        if textbox.Text:match("^%s*$") then return end
        running = true
        stroke.Transparency = 0
        gradient.Offset = Vector2.new(-1, 0)
        local move = TweenService:Create(gradient,
            TweenInfo.new(1.05, Enum.EasingStyle.Linear), {Offset = Vector2.new(1, 0)})
        move:Play()
        TweenService:Create(stroke, TweenInfo.new(0.18), {Thickness = 3.5}):Play()
        move.Completed:Wait()
        TweenService:Create(stroke, TweenInfo.new(0.25), {
            Thickness = 2, Transparency = 0.18
        }):Play()
        task.wait(0.35)
        stroke.Transparency = 1
        running = false
    end

    execBtn.MouseButton1Click:Connect(function()
        if not textbox.Text:match("^%s*$") then task.spawn(pulse) end
    end)
    -- Enter-key execution also triggers the light only when the editor has code.
    game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.Return
            and not textbox.Text:match("^%s*$") then
            task.spawn(pulse)
        end
    end)
end)


--==================================================
-- ADDED: EXECUTE WITH ENTER KEY (APPENDED ONLY)
--==================================================
do
    local UserInputService = game:GetService("UserInputService")

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        -- Exclude phone-only touch keyboards; allow hardware/virtual desktop keyboards.
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
            return
        end

        if input.KeyCode ~= Enum.KeyCode.Return
            and input.KeyCode ~= Enum.KeyCode.KeypadEnter then
            return
        end

        if not textbox:IsFocused() then
            return
        end

        local code = textbox.Text

        if code == "" then
            notify(
                "❌ No script to execute",
                Color3.fromRGB(255, 80, 80)
            )
            return
        end

        local success, err = pcall(function()
            loadstring(code)()
        end)

        if success then
            notify(
                "✅ Script executed!",
                Color3.fromRGB(50, 255, 100)
            )
        else
            notify(
                "❌ Error: " .. tostring(err),
                Color3.fromRGB(255, 50, 50)
            )
        end
    end)
end


