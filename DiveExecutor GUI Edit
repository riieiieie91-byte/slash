    msg.BorderSizePixel = 0
    msg.ZIndex = 200

    local corner = Instance.new("UICorner")
    corner.Parent = msg
    corner.CornerRadius = UDim.new(0, 8)

    task.spawn(function()
        task.wait(2.5)

        for i = 1, 10 do
            msg.TextTransparency += 0.1
            msg.BackgroundTransparency += 0.1
            task.wait(0.05)
        end

        msg:Destroy()
    end)
