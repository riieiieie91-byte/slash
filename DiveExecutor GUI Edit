-- Smooth icon open/close transition, appended without replacing old handlers.
local iconScale = Instance.new("UIScale")
iconScale.Name = "AddedIconMotionScale"
iconScale.Scale = 1
iconScale.Parent = openBtn

local function animateIconVisibility(isVisible)
    if isVisible then
        openBtn.Visible = true
        iconScale.Scale = 0.65
        openBtn.ImageTransparency = 0
        diveFXTween:Create(iconScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1
        }):Play()
    else
        local closeTween = diveFXTween:Create(iconScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Scale = 0.65
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if openBtn.Parent and not frame.Visible then
                openBtn.Visible = false
            end
        end)
    end
end

-- Observe visibility changes from the existing close/open controls.
frame:GetPropertyChangedSignal("Visible"):Connect(function()
    if frame.Visible then
        animateIconVisibility(false)
    elseif not diveView.Visible then
        animateIconVisibility(true)
    end
end)

diveView:GetPropertyChangedSignal("Visible"):Connect(function()
    if diveView.Visible then
        animateIconVisibility(false)
    elseif not frame.Visible then
        animateIconVisibility(true)
    end
end)

