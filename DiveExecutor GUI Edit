makeSCButton("Hop", 108, function()
    -- Public-server hopping requires an executor environment that exposes HttpGet/request.
    local ok, err = pcall(function()
        local currentJob = game.JobId
        local endpoint = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
        local response
        if typeof(game.HttpGet) == "function" then
            response = game:HttpGet(endpoint)
        elseif typeof(request) == "function" then
            local result = request({Url = endpoint, Method = "GET"})
            response = result.Body
        else
            error("This environment does not provide HTTP requests")
        end
        local data = game:GetService("HttpService"):JSONDecode(response)
        for _, server in ipairs(data.data or {}) do
            if server.id ~= currentJob and server.playing < server.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, localPlayer)
                return
            end
        end
        error("No other public server was found")
    end)
    if not ok then
        notify("Hop failed: " .. tostring(err), Color3.fromRGB(255, 90, 90))
    end
end)

